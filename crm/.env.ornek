# Satal sunucu ayarları — bu dosyayı sunucuda ".env" adıyla kopyalayıp doldurun.
# Gerçek ".env" dosyası depoya ASLA yazılmaz.

SITE_ADRESI=https://crm.stagayrimenkul.com.tr

# Veritabanı şifreleri (uzun ve rastgele; örn. `openssl rand -hex 24`)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# İlk yöneticiler: bu adreslerle "Google ile giriş" yapan kişi doğrudan yetkilendirilir.
SAHIP_EPOSTA=
YONETICI_EPOSTALARI=

# Google ile giriş (Google Cloud Console → OAuth istemcisi)
# Yönlendirme adresi: https://crm.stagayrimenkul.com.tr/giris/google/donus
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-posta gönderimi (şifre belirleme ve davet bağlantıları)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Satal <crm@stagayrimenkul.com.tr>

# Claude ile mesaj yazdırma (isteğe bağlı; boşsa bu özellik kapalı kalır)
ANTHROPIC_API_KEY=
# CLAUDE_MODELI=claude-opus-5-5
